# What the shared scripts and the deploy workflow need to know about this service. Not
# secret, committed, and the one file here that differs from service to service: the
# scripts, ovh.mk and the deploy workflow are gcloud-ovh-migrate's template, word for word.
SERVICE=hhbd
# Images built on each release, as name=context:dockerfile[:target], space-separated. Each is
# pushed as ghcr.io/<repository owner>/<name>:<tag>; target picks one stage of a multi-stage
# Dockerfile, which is the last stage when it is left out. The importer is a job (#56): built
# with every release, started only by make ovh-import.
IMAGES="hhbd-app=.:Dockerfile-php:production hhbd-nginx=.:Dockerfile-nginx hhbd-importer=.:Dockerfile-php:importer"
# Jobs run on a timer: none here.
TIMERS=""
# The stack's own containers whose lines are not yet in the format CONTRACT.md §9 asks for, by
# compose service name: both until #101. `make ovh-stack-test` reads past their lines instead of
# failing, says so, and says when one no longer needs it.
LOG_FORMAT_PENDING="nginx app"
