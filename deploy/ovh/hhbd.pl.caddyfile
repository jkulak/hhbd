# hhbd on the shared edge, installed by `make ovh-install` as /srv/edge/sites/hhbd.pl.caddyfile.
# The imports are defined by the edge's Caddyfile (CONTRACT.md §3 in gcloud-ovh-migrate).
#
# Both names are proxied by Cloudflare in Full (strict). The certificate comes from Let's
# Encrypt through Cloudflare, and `cloudflare_only` drops every connection that does not come
# from Cloudflare, so nobody reaches the site around it.
hhbd.pl, www.hhbd.pl {
	import cloudflare_only
	import access_log
	import security_headers
	import compress
	import proxy hhbd-web:80
}
