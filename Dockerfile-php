# =============================================================================
# Stage 1: Builder/Test - includes GD extension for test image generation
# =============================================================================
FROM php:7.4-fpm as builder

# php:7.4 is built on Debian 11 (bullseye), which is past its long-term support, and its
# packages are moving to archive.debian.org: by October 2026 the regular mirrors still listed
# libfcgi's security fix but no longer served the file, which failed every build. The archive
# holds all three bullseye suites.
RUN sed -i 's|http://deb.debian.org|http://archive.debian.org|g' /etc/apt/sources.list

# Install system dependencies including GD libraries and composer requirements
RUN apt-get update && apt-get install -y \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libpng-dev \
    libfcgi-bin \
    libzip-dev \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions including GD for test image generation
RUN docker-php-ext-install pdo pdo_mysql zip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install php-fpm-healthcheck
RUN curl -o /usr/local/bin/php-fpm-healthcheck \
    https://raw.githubusercontent.com/renatomefi/php-fpm-healthcheck/master/php-fpm-healthcheck \
    && chmod +x /usr/local/bin/php-fpm-healthcheck

# Enable status endpoint for healthcheck
RUN echo "pm.status_path = /status" >> /usr/local/etc/php-fpm.d/zz-docker.conf

# Logs to the container's stderr, never to files inside it
COPY conf/php/fpm-logging.conf /usr/local/etc/php-fpm.d/zz-hhbd-logging.conf

WORKDIR /var/www/html/app

# Copy composer files first for layer caching
COPY app/composer.json app/composer.lock* ./

# Install dependencies
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

# Copy application code
COPY app/ ./

# Fix file permissions (ensure files are readable)
RUN find . -type f -exec chmod 644 {} \; && find . -type d -exec chmod 755 {} \;

# Copy production PHP configuration
COPY conf/php/production.ini /usr/local/etc/php/conf.d/99-production.ini

# =============================================================================
# Stage 2: Production - minimal runtime without GD dependencies
# =============================================================================
FROM php:7.4-fpm as production

# Bullseye's packages from the archive, as in the builder stage
RUN sed -i 's|http://deb.debian.org|http://archive.debian.org|g' /etc/apt/sources.list

# Install only runtime system dependencies (no GD libraries)
RUN apt-get update && apt-get install -y \
    libfcgi-bin \
    && rm -rf /var/lib/apt/lists/*

# Install only essential PHP extensions (no GD)
RUN docker-php-ext-install pdo pdo_mysql

# Copy Composer from official image
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy php-fpm-healthcheck from builder
COPY --from=builder /usr/local/bin/php-fpm-healthcheck /usr/local/bin/php-fpm-healthcheck

# Copy PHP-FPM configuration from builder
COPY --from=builder /usr/local/etc/php-fpm.d/zz-docker.conf /usr/local/etc/php-fpm.d/zz-docker.conf
COPY --from=builder /usr/local/etc/php-fpm.d/zz-hhbd-logging.conf /usr/local/etc/php-fpm.d/zz-hhbd-logging.conf

WORKDIR /var/www/html

# Copy built application from builder stage (includes vendor/, all code, correct permissions)
COPY --from=builder /var/www/html/app ./app

# Copy production PHP configuration
COPY conf/php/production.ini /usr/local/etc/php/conf.d/99-production.ini

# =============================================================================
# Stage 3: Importer - the import job (#56), the one image with GD in production
# =============================================================================
# It writes the cover, photo and logo sizes from the one original a batch ships (#96), so it
# needs GD for the formats originals come in: JPEG, PNG and WebP. It runs and exits, so it is
# PHP's CLI image, not FPM, and the web image stays without GD.
FROM php:7.4-cli as importer

# Bullseye's packages from the archive, as in the builder stage
RUN sed -i 's|http://deb.debian.org|http://archive.debian.org|g' /etc/apt/sources.list

RUN apt-get update && apt-get install -y \
    libjpeg62-turbo-dev \
    libpng-dev \
    libwebp-dev \
    && rm -rf /var/lib/apt/lists/* \
    && docker-php-ext-install pdo pdo_mysql \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) gd

WORKDIR /var/www/html

COPY --from=builder /var/www/html/app ./app

COPY conf/php/production.ini /usr/local/etc/php/conf.d/99-production.ini
# A decoded original takes four bytes a pixel, a 6000 x 4000 photo 96 MB, beside the copy being
# scaled; the web's 256M leaves too little room for that. zz- loads it after 99-production.ini.
RUN echo "memory_limit = 512M" > /usr/local/etc/php/conf.d/zz-importer.ini

# A batch arrives as a tar on stdin, so it reaches the OVH host over ssh without a copy left
# there, and the report leaves on stdout: make import and make ovh-import stream it alike.
# Without an argument it is a dry run.
ENTRYPOINT ["sh", "-c", "mkdir -p /tmp/batch && tar -x -C /tmp/batch && exec php app/tools/import.php /tmp/batch \"$@\"", "import"]
CMD ["--dry-run"]
