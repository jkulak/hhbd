# =============================================================================
# The PHP images, all from Debian's own PHP packages on Debian 13 (trixie): nothing is compiled.
# Debian builds, patches and ships them, and a rebuild takes its security updates, while trixie
# is supported (2028, LTS to 2030). PHP 8.4 is trixie's, supported upstream to the end of 2028.
# CLAUDE.md says why 8.4 (#37).
#
#   base        PHP-FPM with the extensions the application uses, configured as hhbd runs it
#   builder     base with composer: CI's app, and where production's vendor/ is installed
#   production  base with the application and its vendor/: the web's image
#   importer    production's application with the CLI and GD: the import job (#56, #96)
# =============================================================================
FROM debian:trixie-slim AS base

# PDO MySQL, mbstring, the XML that ZF reads its config with, opcache; cgi-fcgi from
# libfcgi-bin for the healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
    php8.4-cli \
    php8.4-fpm \
    php8.4-mbstring \
    php8.4-mysql \
    php8.4-opcache \
    php8.4-xml \
    libfcgi-bin \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/php

# The pool as the containers need it (port 9000, the environment kept, stderr for logs), then
# where its logs go, both read after Debian's own www.conf, which goes.
RUN rm /etc/php/8.4/fpm/pool.d/www.conf
COPY conf/php/fpm-pool.conf /etc/php/8.4/fpm/pool.d/www.conf
COPY conf/php/fpm-logging.conf /etc/php/8.4/fpm/pool.d/zz-hhbd-logging.conf
COPY conf/php/production.ini /etc/php/8.4/fpm/conf.d/99-production.ini
COPY conf/php/production.ini /etc/php/8.4/cli/conf.d/99-production.ini
# Healthy when PHP-FPM answers its status page; the compose files run it by this name.
COPY --chmod=755 conf/php/php-fpm-healthcheck /usr/local/bin/php-fpm-healthcheck

WORKDIR /var/www/html
EXPOSE 9000
# SIGQUIT lets a worker finish its request before FPM stops.
STOPSIGNAL SIGQUIT
CMD ["php-fpm8.4", "--nodaemonize"]

# =============================================================================
# Builder: composer, and the application with its vendor/. CI's app runs on it, so it also has
# what composer needs to install the dev dependencies there: unzip and git.
# =============================================================================
FROM base AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html/app

# Composer files first, so the dependencies' layer survives a change to the code. Without the
# log handlers production.ini prepends, which are not here before the code is.
COPY app/composer.json app/composer.lock* ./
RUN php -d auto_prepend_file= /usr/bin/composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

COPY app/ ./
RUN find . -type f -exec chmod 644 {} \; && find . -type d -exec chmod 755 {} \;

# =============================================================================
# Production: base with the application. Composer stays, as the local compose file mounts app/
# over it and installs vendor/ with it there.
# =============================================================================
FROM base AS production

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --from=builder /var/www/html/app ./app

# =============================================================================
# Importer: the import job (#56). It writes the cover, photo and logo sizes from the one
# original a batch ships (#96), so it needs GD, for JPEG, PNG and WebP; the web's image stays
# without. It runs and exits: the CLI is enough, FPM in the layer below costs nothing extra.
# =============================================================================
FROM base AS importer

RUN apt-get update && apt-get install -y --no-install-recommends php8.4-gd \
    && rm -rf /var/lib/apt/lists/* \
    && php -r 'exit((extension_loaded("pdo_mysql") && gd_info()["JPEG Support"] && gd_info()["PNG Support"] && gd_info()["WebP Support"]) ? 0 : 1);'

COPY --from=builder /var/www/html/app ./app
# A decoded original takes four bytes a pixel, a 6000 x 4000 photo 96 MB, beside the copy being
# scaled; the web's 256M leaves too little room for that. zz- loads it after 99-production.ini.
RUN echo "memory_limit = 512M" > /etc/php/8.4/cli/conf.d/zz-importer.ini

# A batch arrives as a tar on stdin, so it reaches the OVH host over ssh without a copy left
# there, and the report leaves on stdout: make import and make ovh-import stream it alike.
# Without an argument it is a dry run.
STOPSIGNAL SIGTERM
ENTRYPOINT ["sh", "-c", "mkdir -p /tmp/batch && tar -x -C /tmp/batch && exec php app/tools/import.php /tmp/batch \"$@\"", "import"]
CMD ["--dry-run"]
